node('stage') {
    stage ('Checkout') {
    	checkout scm
    }
    
    stage ('Source package') {
sh '''
PKGVERSION=$(git describe --tags $(git rev-list --tags --max-count=1))
dch -b -v ${PKGVERSION}.${BUILD_NUMBER}.dev \\"---new build---\\"
mkdir -p tmp_src
cd tmp_src
dpkg-source -Zgzip -I -Itmp_src -b ../
'''
    }

    stage ('Publish source package') {
      withCredentials([usernamePassword(credentialsId: 'apt.registries.creds', usernameVariable: 'USERNAME', passwordVariable: 'PASSWORD')]) {
sh '''
SOURCE_NAME=`cat debian/control |grep Source: | sed \'s/Source://g\' | sed \'s/ //g\'`
cd tmp_src
# UPLOAD FILES TO TEMPORARY DIRECTORY IN LOOP
for i in `ls`; do
curl -k -u $USERNAME:$PASSWORD -X POST -F file=@$i https://apt.registries.intranet.ips.su/upload/api/files/upload_${SOURCE_NAME}_buster-ci-stage && rm $i
done;
# MOVE FILE FROM UPLOAD DIRECTORY TO REPOSITORY
curl -k -u $USERNAME:$PASSWORD -X POST https://apt.registries.intranet.ips.su/upload/api/repos/buster-ci-stage/file/upload_${SOURCE_NAME}_buster-ci-stage
# PUBLISH REPOSITORY TO PUBLIC (with sign)
curl -k -u $USERNAME:$PASSWORD -X PUT -H 'Content-Type: application/json' --data '{}' https://apt.registries.intranet.ips.su/upload/api/publish/:./buster
curl -k -u $USERNAME:$PASSWORD -X POST https://apt.registries.intranet.ips.su/service/rest/v1/repositories/debian_ci_buster/invalidate-cache
'''
        }
    }

    stage ('Build package') {
	try {
sh '''
PKGVERSION=$(git describe --tags $(git rev-list --tags --max-count=1))
SOURCE_NAME=`cat debian/control |grep Source: | sed \'s/Source://g\' | sed \'s/ //g\'`

export MAKE_ARGS=-j16

while true; do
    apt-get update && break
done
apt-get build-dep -y ${SOURCE_NAME}
apt-get source ${SOURCE_NAME}
apt-get -y --new-pkgs upgrade

cd ${SOURCE_NAME}-${PKGVERSION}.${BUILD_NUMBER}.dev
dpkg-buildpackage -us -uc -b -rfakeroot
'''
		currentBuild.result = 'SUCCESS'
	} catch (err) {
		currentBuild.result = 'FAILURE'
		error('Build Failed')
	} finally {
		step([$class: 'Mailer', notifyEveryUnstableBuild: true, recipients: emailextrecipients([requestor(), culprits()]), sendToIndividuals: true])
        }
    }

    stage ('Publish package') {
      withCredentials([usernamePassword(credentialsId: 'apt.registries.creds', usernameVariable: 'USERNAME', passwordVariable: 'PASSWORD')]) {
sh '''
SOURCE_NAME=`cat debian/control |grep Source: | sed \'s/Source://g\' | sed \'s/ //g\'`
# UPLOAD FILES TO TEMPORARY DIRECTORY IN LOOP
for i in `ls *.deb`; do
curl -k -u $USERNAME:$PASSWORD -X POST -F file=@$i https://apt.registries.intranet.ips.su/upload/api/files/upload_${SOURCE_NAME}_buster-ci-stage
done;
# MOVE FILE FROM UPLOAD DIRECTORY TO REPOSITORY
curl -k -u $USERNAME:$PASSWORD -X POST https://apt.registries.intranet.ips.su/upload/api/repos/buster-ci-stage/file/upload_${SOURCE_NAME}_buster-ci-stage
# PUBLISH REPOSITORY TO PUBLIC (with sign)
curl -k -u $USERNAME:$PASSWORD -X PUT -H 'Content-Type: application/json' --data '{}' https://apt.registries.intranet.ips.su/upload/api/publish/:./buster
curl -k -u $USERNAME:$PASSWORD -X POST https://apt.registries.intranet.ips.su/service/rest/v1/repositories/debian_ci_buster/invalidate-cache
'''
        }
    }

    stage ('Post Build') {
		archiveArtifacts artifacts: '*.deb', onlyIfSuccessful: true	
    }
}
